@model IEnumerable<BloodBank.Models.Donor>

@{
    ViewData["Title"] = "Donors";
}

<h2>Donor List</h2>

<p>
    <a href="/Donors/Create">Create New</a>
</p>

<table border="1" cellpadding="8">

    <tr>
        <th>Full Name</th>
        <th>Blood Group</th>
        <th>Contact No</th>
        <th>City</th>
        <th>Last Donation</th>
        <th>Actions</th>
    </tr>

    @foreach (var donor in Model)
    {
        <tr>

            <td>@donor.FullName</td>

            <td>@donor.BloodGroup</td>

            <td>@donor.ContactNo</td>

            <td>@donor.City</td>

            <td>@donor.LastDonationDate.ToString("dd-MM-yyyy")</td>

            <td>

                <a href="/Donors/Edit/@donor.DonorId">Edit</a> |

                <a href="/Donors/Details/@donor.DonorId">Details</a> |

                <a href="/Donors/Delete/@donor.DonorId">Delete</a>

            </td>

        </tr>
    }

</table>